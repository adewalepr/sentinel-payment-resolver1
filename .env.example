# Sentinel Payment Resolver - Environment Variables

# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_NAME=Bookings

# Flutterwave Configuration
FLW_PUBLIC_KEY=your_public_key
FLW_SECRET_KEY=your_secret_key
FLW_SECRET_HASH=your_webhook_secret_hash

# Make.com Configuration
MAKE_WEBHOOK_URL=your_make_webhook_for_failed_payments

# Server Configuration
PORT=3000
